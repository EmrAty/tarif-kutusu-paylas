{
  "appId": "com.tarifkutusu.app",
  "appName": "Tarif Kutusu",
  "webDir": "dist",
  "server": {
    "url": "https://tarifkutusu.app",
    "cleartext": false
  },
  "android": {
    "backgroundColor": "#27442D"
  },
  "ios": {
    "backgroundColor": "#27442D"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#27442D",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com"]
    }
  }
}
